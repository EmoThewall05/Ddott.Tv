<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Demos</title>
<style>
  :root { --terra:#C4623B; --terra-d:#A94E2B; --cream:#FBF3E4; --card:#FFFCF6; --line:#EADFCB; --ink:#3A2A22; --muted:#8C7A6B; --star:#4A86C5; }
  * { box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
  html, body { margin:0; padding:0; background:var(--cream); color:var(--ink); font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif; }
  .dm-wrap { max-width:560px; margin:0 auto; padding:0 14px 110px; }
  .dm-head { position:sticky; top:0; z-index:20; background:var(--cream); padding:16px 4px 0; }
  .dm-title { margin:0 0 10px; font-size:26px; font-weight:800; color:var(--terra); letter-spacing:0.3px; }
  .dm-tabs { display:flex; gap:6px; border-bottom:1px solid var(--line); }
  .dm-tab { flex:1; text-align:center; padding:11px 4px; font-size:15px; font-weight:600; color:var(--muted); cursor:pointer; border-bottom:3px solid transparent; margin-bottom:-1px; }
  .dm-tab.active { color:var(--terra); border-bottom-color:var(--terra); }
  .dm-card { background:var(--card); border:1px solid var(--line); border-radius:18px; padding:14px; margin-top:14px; }
  .dm-user { display:flex; align-items:center; gap:10px; margin-bottom:10px; }
  .dm-av { width:42px; height:42px; border-radius:50%; background:#F0D3C6; color:var(--terra-d); display:flex; align-items:center; justify-content:center; font-weight:700; font-size:15px; overflow:hidden; flex-shrink:0; }
  .dm-av img { width:100%; height:100%; object-fit:cover; }
  .dm-name { font-weight:700; font-size:15px; }
  .dm-time { font-size:12.5px; color:var(--muted); }
  .dm-body { font-size:16px; line-height:1.55; margin:6px 0 10px; white-space:pre-wrap; word-wrap:break-word; }
  .dm-media { width:100%; border-radius:12px; margin:4px 0 10px; display:block; background:#EFE3CE; max-height:420px; object-fit:cover; }
  .dm-vwrap { position:relative; width:100%; aspect-ratio:9/16; max-height:70vh; margin:4px 0 10px; border-radius:12px; overflow:hidden; background:#000; }
  .dm-vwrap iframe { position:absolute; inset:0; width:100%; height:100%; border:0; }
  .dm-exp { display:inline-block; font-size:12px; color:var(--terra-d); background:#F6E0D5; padding:3px 9px; border-radius:20px; margin-bottom:8px; }
  .dm-stars { display:flex; justify-content:space-between; padding:6px 2px 0; }
  .dm-s { display:flex; flex-direction:column; align-items:center; gap:2px; flex:1; }
  .dm-s span { font-size:13px; color:var(--ink); }
  .dm-star { width:46px; height:46px; fill:var(--star); stroke:none; }
  .dm-star text { fill:#fff; font-size:8.5px; font-weight:700; font-family:system-ui,sans-serif; }
  .dm-star.mine { stroke:#2F5F96; stroke-width:1.6; }
  .dm-rating.on .dm-star { cursor:pointer; animation:dmPulse 1s ease-in-out infinite; }
  @keyframes dmPulse { 0%,100%{transform:scale(1)} 50%{transform:scale(1.1)} }
  .dm-sum { display:flex; align-items:center; justify-content:space-between; border-top:1px solid var(--line); margin-top:10px; padding-top:10px; font-size:14px; color:var(--ink); }
  .dm-sum small { color:var(--muted); font-size:14px; }
  .dm-rate-btn { background:none; border:none; color:var(--terra); font-weight:700; font-size:15px; cursor:pointer; padding:4px 2px; }
  .dm-fab { position:fixed; right:18px; bottom:18px; background:var(--terra); color:#fff; border:none; border-radius:30px; padding:14px 20px; font-size:16px; font-weight:700; box-shadow:0 6px 18px rgba(196,98,59,0.4); cursor:pointer; z-index:30; }
  .dm-empty { text-align:center; color:var(--muted); padding:50px 10px; font-size:15px; line-height:1.6; }
  .dm-sheet-bg { position:fixed; inset:0; background:rgba(58,42,34,0.45); z-index:50; display:none; align-items:flex-end; justify-content:center; }
  .dm-sheet-bg.show { display:flex; }
  .dm-sheet { background:var(--cream); width:100%; max-width:560px; border-radius:22px 22px 0 0; padding:20px 16px 26px; max-height:90%; overflow-y:auto; }
  .dm-sheet h3 { margin:0 0 12px; color:var(--terra); font-size:19px; }
  .dm-sheet label { display:block; font-size:13px; color:var(--muted); margin:10px 0 4px; }
  .dm-sheet input, .dm-sheet textarea { width:100%; border:1px solid var(--line); background:var(--card); border-radius:12px; padding:12px; font-size:15px; color:var(--ink); font-family:inherit; }
  .dm-sheet textarea { min-height:100px; resize:vertical; }
  .dm-prev { margin-top:8px; font-size:13px; color:var(--muted); }
  .dm-prev img { display:block; max-width:100%; max-height:180px; border-radius:12px; margin-top:6px; }
  .dm-prog { display:none; height:8px; background:#EADFCB; border-radius:8px; overflow:hidden; margin-top:14px; }
  .dm-prog-b { height:100%; width:0; background:var(--terra); transition:width 0.2s; }
  .dm-prog-b.ind { width:40% !important; animation:dmInd 1.1s ease-in-out infinite alternate; }
  @keyframes dmInd { from{margin-left:0} to{margin-left:60%} }
  .dm-progt { font-size:13px; color:var(--muted); margin-top:6px; min-height:16px; }
  .dm-row { display:flex; gap:10px; margin-top:14px; }
  .dm-btn { flex:1; padding:13px; border-radius:12px; font-size:15px; font-weight:700; border:none; cursor:pointer; }
  .dm-btn.pri { background:var(--terra); color:#fff; }
  .dm-btn.sec { background:#EFE3CE; color:var(--ink); }
  .dm-btn:disabled { opacity:0.6; }
  .dm-toast { position:fixed; left:50%; bottom:84px; transform:translateX(-50%); background:var(--ink); color:#fff; padding:10px 16px; border-radius:20px; font-size:14px; z-index:80; display:none; max-width:90%; text-align:center; }
  /* ===== DEMOS PROFILE SETUP (CSS) ===== */
  .dm-pf-note { font-size:13.5px; color:var(--muted); line-height:1.5; margin:0 0 6px; }
  .dm-pf-hint { font-size:12px; color:var(--muted); margin-top:4px; }
  .dm-pf-status { font-size:13px; color:var(--terra-d); margin-top:10px; min-height:16px; }
  .dm-sheet select { width:100%; border:1px solid var(--line); background:var(--card); border-radius:12px; padding:12px; font-size:15px; color:var(--ink); font-family:inherit; }
  /* ===== DEMOS SOCIAL (CSS) ===== */
  .dm-top { display:flex; align-items:center; gap:8px; margin-bottom:10px; }
  .dm-top .dm-title { margin:0; flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .dm-back { width:38px; height:38px; border-radius:50%; border:none; background:#EFE3CE; color:var(--ink); font-size:20px; cursor:pointer; flex-shrink:0; }
  .dm-me { width:40px; height:40px; border-radius:50%; border:2px solid var(--terra); background:#F0D3C6; color:var(--terra-d); font-weight:700; font-size:14px; overflow:hidden; padding:0; cursor:pointer; flex-shrink:0; display:flex; align-items:center; justify-content:center; }
  .dm-me img { width:100%; height:100%; object-fit:cover; }
  .dm-strip { display:flex; gap:12px; overflow-x:auto; padding:14px 2px 4px; }
  .dm-bub { display:flex; flex-direction:column; align-items:center; gap:5px; width:64px; flex-shrink:0; cursor:pointer; }
  .dm-bav { position:relative; width:58px; height:58px; border-radius:50%; background:#F0D3C6; color:var(--terra-d); display:flex; align-items:center; justify-content:center; font-weight:700; font-size:16px; border:3px solid var(--cream); box-shadow:0 0 0 2px #E7C9B8; }
  .dm-bav.ring { box-shadow:0 0 0 2.5px var(--terra); }
  .dm-bav img { width:100%; height:100%; object-fit:cover; border-radius:50%; }
  .dm-plus { position:absolute; right:-2px; bottom:-2px; width:22px; height:22px; border-radius:50%; background:var(--terra); color:#fff; font-size:15px; line-height:20px; text-align:center; border:2px solid var(--cream); }
  .dm-bn { font-size:12px; color:var(--ink); max-width:64px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .dm-user[data-uid] { cursor:pointer; }
  .dm-star text { stroke:none; }
  .dm-pbanner { height:130px; border-radius:16px; background:#EBCDBB; overflow:hidden; margin-top:6px; }
  .dm-pbanner img { width:100%; height:100%; object-fit:cover; display:block; }
  .dm-phead { display:flex; align-items:flex-end; justify-content:space-between; padding:0 6px; margin-top:-40px; }
  .dm-pav { width:88px; height:88px; border-radius:50%; background:#F0D3C6; color:var(--terra-d); border:4px solid var(--cream); display:flex; align-items:center; justify-content:center; font-weight:800; font-size:26px; overflow:hidden; }
  .dm-pav img { width:100%; height:100%; object-fit:cover; }
  .dm-pbtn { flex:none; padding:10px 18px; }
  .dm-pname { font-size:20px; font-weight:800; margin:10px 6px 0; }
  .dm-puser { font-size:14px; color:var(--muted); margin:0 6px; }
  .dm-pbio { font-size:15px; line-height:1.5; margin:10px 6px 0; white-space:pre-wrap; word-wrap:break-word; }
  .dm-pmeta { display:flex; flex-wrap:wrap; gap:6px 14px; font-size:13.5px; color:var(--muted); margin:8px 6px 0; }
  .dm-pmeta a { color:var(--terra-d); text-decoration:none; }
  .dm-pstats { display:flex; margin:14px 0 4px; border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
  .dm-pstats div { flex:1; text-align:center; padding:10px 0; cursor:pointer; }
  .dm-pstats b { display:block; font-size:18px; }
  .dm-pstats span { font-size:12.5px; color:var(--muted); }
  .dm-create { background:var(--card); border:1px solid var(--line); border-radius:16px; padding:12px; margin:12px 0 4px; }
  .dm-cr-t { font-size:13px; color:var(--muted); margin-bottom:8px; }
  .dm-cr-row { display:flex; gap:8px; }
  .dm-cr-row button { flex:1; padding:11px 4px; border-radius:12px; border:1px solid var(--line); background:var(--cream); color:var(--terra-d); font-weight:700; font-size:14px; cursor:pointer; }
  .dm-cr-col { display:flex; flex-direction:column; gap:10px; }
  .dm-cr-col .dm-btn { flex:none; }
  .dm-lrow { display:flex; align-items:center; gap:10px; padding:10px 2px; border-bottom:1px solid var(--line); cursor:pointer; }
  .dm-logout { color:#C0392B; border-color:rgba(192,57,43,0.45); }
  /* ===== DLOOK FLOAT (CSS) ===== */
  .dm-strip { padding-bottom:12px; }
  /* DLOOK STRIP V2 */
  @keyframes dmFloat {
    0%   { transform: translate(0,0); }
    25%  { transform: translate(5px,-7px); }
    50%  { transform: translate(0,-14px); }
    75%  { transform: translate(-5px,-7px); }
    100% { transform: translate(0,0); }
  }
  .dm-strip { padding-left:10px; padding-right:10px; padding-top:20px; }
  .dm-bub { animation: dmFloat 3.4s ease-in-out infinite; will-change: transform; }
  .dm-bub:nth-child(2n)  { animation-duration: 4.1s; animation-delay: -1.2s; }
  .dm-bub:nth-child(3n)  { animation-duration: 3.7s; animation-delay: -2.1s; }
  .dm-bub:nth-child(5n)  { animation-duration: 4.6s; animation-delay: -0.6s; }
  .dm-bub:nth-child(7n)  { animation-duration: 3.1s; animation-delay: -1.8s; }
  .dm-bav { transition: transform .35s cubic-bezier(.34,1.8,.5,1); }
  .dm-bub:active .dm-bav { transform: scale(.86); transition: transform .12s ease-out; }
  @media (prefers-reduced-motion: reduce) { .dm-bub { animation: none; } }
  /* ===== DLOOK VIEWER (CSS) ===== */
  .dm-vw { position:fixed; top:0; right:0; bottom:0; left:0; z-index:99999; background:#000; display:none; flex-direction:column; }
  .dm-vw.show { display:flex; }
  .vw-bars { display:flex; gap:4px; padding:10px 10px 6px; }
  .vw-bar { flex:1; height:3px; border-radius:2px; background:rgba(255,255,255,.3); overflow:hidden; }
  .vw-fill { height:100%; width:0; background:#fff; }
  .vw-top { display:flex; align-items:center; justify-content:space-between; padding:4px 12px; color:#fff; font-size:13px; }
  .vw-x { background:none; border:none; color:#fff; font-size:26px; cursor:pointer; padding:4px 8px; }
  .vw-stage { flex:1; min-height:0; display:flex; align-items:center; justify-content:center; }
  .vw-stage img, .vw-stage video { max-width:100%; max-height:100%; object-fit:contain; }
  .vw-cap { color:#fff; padding:14px 16px 22px; font-size:15px; text-align:center; white-space:pre-wrap; word-wrap:break-word; }
</style>
</head>
<body>
<div class="dm-wrap">
  <div class="dm-head">
    <div class="dm-top">
      <button class="dm-back" id="backBtn" aria-label="Back" style="display:none">&#8592;</button>
      <h1 class="dm-title" id="topTitle">Demos</h1>
      <button class="dm-me" id="meBtn" aria-label="My profile"></button>
    </div>
    <div class="dm-tabs" id="feedTabs">
      <div class="dm-tab active" data-m="foryou">For You</div>
      <div class="dm-tab" data-m="following">Following</div>
    </div>
  </div>
  <div id="vFeed">
    <div class="dm-strip" id="strip"></div>
    <div id="feed"></div>
    <div id="more"></div>
  </div>
  <div id="vProfile" style="display:none"></div>
</div>

<!-- DLOOK VIEWER -->
<div class="dm-vw" id="vw">
  <div class="vw-bars" id="vwBars"></div>
  <div class="vw-top"><span id="vwInfo"></span><button class="vw-x" aria-label="Close">&#10005;</button></div>
  <div class="vw-stage" id="vwStage"></div>
  <div class="vw-cap" id="vwCap"></div>
</div>

<button class="dm-fab" id="fab">+ Create</button>

<div class="dm-sheet-bg" id="sheetBg">
  <div class="dm-sheet">
    <h3 id="sheetTitle">New post</h3>
    <div id="sheetForm"></div>
    <div class="dm-prog" id="prog"><div class="dm-prog-b" id="progB"></div></div>
    <div class="dm-progt" id="progT"></div>
    <div class="dm-row">
      <button class="dm-btn sec" id="sheetCancel">Cancel</button>
      <button class="dm-btn pri" id="sheetPost">Post</button>
    </div>
  </div>
</div>
<!-- DEMOS SOCIAL SHEETS -->
<div class="dm-sheet-bg" id="crBg">
  <div class="dm-sheet">
    <h3>Create</h3>
    <div class="dm-cr-col">
      <button class="dm-btn sec" data-mk="dwall">Write a Dwall post</button>
      <button class="dm-btn sec" data-mk="dreels">Upload a Dreel</button>
      <button class="dm-btn sec" data-mk="dlooks">Add a Dlook (12 hours)</button>
    </div>
    <div class="dm-row"><button class="dm-btn sec" id="crCancel">Cancel</button></div>
  </div>
</div>
<div class="dm-sheet-bg" id="lsBg">
  <div class="dm-sheet">
    <h3 id="lsTitle">Followers</h3>
    <div id="lsList"></div>
    <div class="dm-row"><button class="dm-btn sec" id="lsClose">Close</button></div>
  </div>
</div>
<div class="dm-sheet-bg" id="edBg">
  <div class="dm-sheet">
    <h3>Edit profile</h3>
    <p class="dm-pf-note" id="ed_un"></p>
    <label>Name</label>
    <input id="ed_name" maxlength="40">
    <label>Bio</label>
    <textarea id="ed_bio" maxlength="200" style="min-height:70px"></textarea>
    <label>Location</label>
    <input id="ed_loc" maxlength="60">
    <label>Website</label>
    <input id="ed_web" maxlength="200" autocapitalize="none" placeholder="https://...">
    <label>Profile photo (leave empty to keep)</label>
    <input id="ed_av" type="file" accept="image/*">
    <label>Banner (leave empty to keep)</label>
    <input id="ed_bn" type="file" accept="image/*">
    <div class="dm-pf-status" id="ed_status"></div>
    <div class="dm-row">
      <button class="dm-btn sec" id="edCancel">Cancel</button>
      <button class="dm-btn pri" id="edSave">Save</button>
    </div>
  </div>
</div>
<!-- DEMOS PROFILE SETUP -->
<div class="dm-sheet-bg" id="pfBg">
  <div class="dm-sheet">
    <h3>Create your Demos profile</h3>
    <p class="dm-pf-note">This profile is only for Demos. Your username is how people find you.</p>
    <label>Username</label>
    <input id="pf_user" maxlength="20" autocapitalize="none" autocomplete="off" placeholder="e.g. dwin05">
    <div class="dm-pf-hint">3 to 20 characters: a-z, 0-9 and _</div>
    <label>Name</label>
    <input id="pf_name" maxlength="40" placeholder="Your name">
    <label>Bio (optional)</label>
    <textarea id="pf_bio" maxlength="200" style="min-height:70px"></textarea>
    <label>Profile photo (optional)</label>
    <input id="pf_av" type="file" accept="image/*">
    <label>Banner (optional)</label>
    <input id="pf_bn" type="file" accept="image/*">
    <div class="dm-pf-status" id="pf_status"></div>
    <div class="dm-row">
      <button class="dm-btn sec" id="pfCancel">Later</button>
      <button class="dm-btn pri" id="pfSave">Create profile</button>
    </div>
  </div>
</div>
<div class="dm-toast" id="toast"></div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<script src="/supabase-config.js"></script>
<script src="https://cdn.jsdelivr.net/npm/tus-js-client@4/dist/tus.min.js"></script>
<script src="/config/cloudflare-stream-config.js"></script>
<script>
(function(){
  var DB = window.db;
  window._dbg = function(){};
  var TABLE = { dwall:'demos_dwall', dreels:'demos_dreels', dlooks:'demos_dlooks' };
  var FAB_TXT = { dwall:'+ New post', dreels:'+ New reel', dlooks:'+ New look' };
  var BUCKET = 'demos-media';
  var STAR_PTS = '12,2 15.1,8.6 22,9.3 16.8,14 18.4,21 12,17.3 5.6,21 7.2,14 2,9.3 8.9,8.6';
  var me = null, tab = 'dwall', S = {}, M = {}, busy = false;

  function $(s){ return document.querySelector(s); }
  function esc(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  function safeUrl(u){ try { var x = new URL(u, location.href); return (x.protocol === 'https:' || x.protocol === 'http:') ? x.href : ''; } catch(e){ return ''; } }
  function ago(t){
    var s = (Date.now() - new Date(t).getTime()) / 1000;
    if (s < 60) return 'just now';
    if (s < 3600) return Math.floor(s/60) + ' min ago';
    if (s < 86400) return Math.floor(s/3600) + ' hours ago';
    return Math.floor(s/86400) + ' days ago';
  }
  function left(t){
    var m = Math.max(0, Math.floor((new Date(t).getTime() - Date.now()) / 60000));
    if (m >= 60) return Math.floor(m/60) + 'h ' + (m % 60) + 'm left';
    return m + 'm left';
  }
  function toast(msg){
    var t = $('#toast'); t.textContent = msg; t.style.display = 'block';
    clearTimeout(toast._t); toast._t = setTimeout(function(){ t.style.display = 'none'; }, 2800);
  }
  function goLogin(){ try { window.top.location.href = '/auth/login.html'; } catch(e){ location.href = '/auth/login.html'; } }

  function starSvg(n, mine){
    return '<svg viewBox="0 0 24 24" class="dm-star' + (mine ? ' mine' : '') + '" data-s="' + n + '"><polygon points="' + STAR_PTS + '"/><text x="12" y="15.4" text-anchor="middle">' + n + '</text></svg>';
  }
  function ratingHTML(id, on){
    var st = S[id] || {}, my = M[id], i, cols = '';
    for (i = 1; i <= 5; i++) cols += '<div class="dm-s">' + starSvg(i, my === i) + '<span>' + (st['stars_' + i] || 0) + '</span></div>';
    var avg = st.average_stars != null ? Number(st.average_stars).toFixed(1) : '–';
    var total = st.total_reviews || 0;
    return '<div class="dm-rating' + (on ? ' on' : '') + '" data-id="' + id + '">' +
      '<div class="dm-stars">' + cols + '</div>' +
      '<div class="dm-sum"><span>Average <b>' + avg + '</b> <small>· ' + total + (total === 1 ? ' review' : ' reviews') + '</small></span>' +
      '<button class="dm-rate-btn">' + (on ? 'Tap a star' : (my ? 'Change' : 'Rate this')) + '</button></div></div>';
  }

  function videoHTML(url, poster){
    var m = /^(https:\/\/customer-[a-z0-9]+\.cloudflarestream\.com)\/([a-f0-9]{32})\//.exec(url || '');
    if (m) {
      return '<div class="dm-vwrap"><iframe src="' + m[1] + '/' + m[2] + '/iframe" loading="lazy" allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe></div>';
    }
    var u = safeUrl(url);
    if (!u) return '';
    var p = poster && safeUrl(poster) ? ' poster="' + esc(safeUrl(poster)) + '"' : '';
    return '<video class="dm-media" controls playsinline preload="metadata"' + p + ' src="' + esc(u) + '"></video>';
  }
  function imageHTML(url){
    var u = safeUrl(url);
    return u ? '<img class="dm-media" loading="lazy" src="' + esc(u) + '" alt="">' : '';
  }

  /* ===== DEMOS SOCIAL (JS) ===== */
  var K = {}, PV = null, mode = 'foryou', SEED = Math.random().toString(36).slice(2);
  var stack = [{ v:'feed' }], feedOff = 0, feedTok = 0, stripTok = 0, profTok = 0, contTok = 0;
  var feedDirty = true, FEED_N = 20, followingSet = {}, edBusy = false, folBusy = false;

  function avInner(p, name){
    if (p && p.avatar_url && safeUrl(p.avatar_url)) return '<img src="' + esc(safeUrl(p.avatar_url)) + '" alt="">';
    return esc(String(name || 'U').slice(0, 2).toUpperCase());
  }

  function cardHTML(r, prof){
    var kind = r.kind || tab; K[r.id] = kind;
    var p = prof[r.user_id] || {};
    var name = p.display_name || p.username || 'User';
    var media = '', body = '', exp = '';
    if (kind === 'dwall') {
      if (r.body) body = '<div class="dm-body">' + esc(r.body) + '</div>';
      if (r.media_url) media = imageHTML(r.media_url);
    } else if (kind === 'dreels') {
      if (r.caption) body = '<div class="dm-body">' + esc(r.caption) + '</div>';
      media = videoHTML(r.video_url, r.thumbnail_url);
    } else {
      if (r.caption) body = '<div class="dm-body">' + esc(r.caption) + '</div>';
      exp = '<div class="dm-exp">⏳ ' + esc(left(r.expires_at)) + '</div>';
      media = r.media_type === 'video' ? videoHTML(r.media_url) : imageHTML(r.media_url);
    }
    var sub = (p.username ? '@' + esc(p.username) + ' · ' : '') + esc(ago(r.created_at));
    return '<div class="dm-card"><div class="dm-user" data-uid="' + esc(r.user_id) + '"><div class="dm-av">' + avInner(p, name) + '</div><div><div class="dm-name">' + esc(name) + '</div><div class="dm-time">' + sub + '</div></div></div>' +
      exp + body + media + ratingHTML(r.id, false) + '</div>';
  }

  async function hydrate(rows){
    var uids = Array.from(new Set(rows.map(function(r){ return r.user_id; })));
    var ids = rows.map(function(r){ return r.id; });
    var out = await Promise.all([
      DB.from('demos_profiles').select('user_id,display_name,username,avatar_url').in('user_id', uids),
      DB.from('demos_review_stats').select('*').in('target_id', ids),
      me ? DB.from('demos_reviews').select('target_id,stars').eq('user_id', me.id).in('target_id', ids) : Promise.resolve({ data:[] })
    ]);
    var prof = {};
    (out[0].data || []).forEach(function(p){ prof[p.user_id] = p; });
    (out[1].data || []).forEach(function(s){ S[s.target_id] = s; });
    (out[2].data || []).forEach(function(m){ M[m.target_id] = m.stars; });
    return prof;
  }

  /* ---------- feed ---------- */
  async function loadFeed(append){
    var list = $('#feed'), more = $('#more'), tok;
    if (!append) { tok = ++feedTok; feedOff = 0; more.innerHTML = ''; loadStrip(); } else { tok = feedTok; }
    if (!me) {
      list.innerHTML = '<div class="dm-empty">Log in to see Demos.<br><button class="dm-btn pri" data-login="1" style="margin-top:14px;max-width:220px">Log in</button></div>';
      return;
    }
    if (!append) list.innerHTML = '<div class="dm-empty">Loading…</div>';
    var res = await DB.rpc('demos_feed', { p_mode: mode, p_seed: SEED, p_limit: FEED_N, p_offset: feedOff });
    if (tok !== feedTok) return;
    if (res.error) { list.innerHTML = '<div class="dm-empty">Could not load.<br>' + esc(res.error.message) + '</div>'; return; }
    var rows = res.data || [];
    if (!append && !rows.length) {
      list.innerHTML = '<div class="dm-empty">' + (mode === 'following' ? 'Nothing here yet.<br>Follow people to see their posts here.' : 'Nothing here yet.<br>Be the first to create something.') + '</div>';
      feedDirty = false;
      return;
    }
    var prof = await hydrate(rows);
    if (tok !== feedTok) return;
    var html = rows.map(function(r){ return cardHTML(r, prof); }).join('');
    if (append) list.insertAdjacentHTML('beforeend', html); else list.innerHTML = html;
    feedOff += rows.length;
    more.innerHTML = rows.length >= FEED_N ? '<button class="dm-btn sec" data-more="1" style="margin:16px 0">Load more</button>' : '';
    feedDirty = false;
  }

  async function loadStrip(){
    var el = $('#strip'), tok = ++stripTok;
    if (!me) { el.innerHTML = ''; return; }
    var out = await Promise.all([
      DB.from('demos_dlooks').select('user_id,created_at').gt('expires_at', new Date().toISOString()).order('created_at', { ascending:false }).limit(100),
      DB.from('demos_follows').select('following_id').eq('follower_id', me.id)
    ]);
    if (tok !== stripTok) return;
    followingSet = {};
    (out[1].data || []).forEach(function(f){ followingSet[f.following_id] = true; });
    var seen = {}, uids = [], hasMine = false;
    (out[0].data || []).forEach(function(r){
      if (r.user_id === me.id) { hasMine = true; return; }
      if (seen[r.user_id]) return;
      if (mode === 'following' && !followingSet[r.user_id]) return;
      seen[r.user_id] = true; uids.push(r.user_id);
    });
    var prof = {};
    if (uids.length) {
      var pr = await DB.from('demos_profiles').select('user_id,display_name,username,avatar_url').in('user_id', uids);
      if (tok !== stripTok) return;
      (pr.data || []).forEach(function(p){ prof[p.user_id] = p; });
    }
    var mine = myProfile ? avInner(myProfile, myProfile.display_name || myProfile.username) : '';
    var html = hasMine
      ? '<div class="dm-bub" data-uid="' + esc(me.id) + '" data-ctab="dlooks"><div class="dm-bav ring">' + mine + '<span class="dm-plus" data-mk="dlooks">+</span></div><div class="dm-bn">Your look</div></div>'
      : '<div class="dm-bub" data-mk="dlooks"><div class="dm-bav">' + mine + '<span class="dm-plus">+</span></div><div class="dm-bn">Your look</div></div>';
    uids.forEach(function(u){
      var p = prof[u] || {}, nm = p.username || p.display_name || 'User';
      html += '<div class="dm-bub" data-uid="' + esc(u) + '" data-ctab="dlooks"><div class="dm-bav ring">' + avInner(p, nm) + '</div><div class="dm-bn">' + esc(nm) + '</div></div>';
    });
    el.innerHTML = html;
  }

  /* ---------- profile ---------- */
  function renderHead(){
    var p = PV.p, st = PV.st, name = p.display_name || p.username || 'User';
    var banner = p.banner_url && safeUrl(p.banner_url) ? '<img src="' + esc(safeUrl(p.banner_url)) + '" alt="">' : '';
    var web = p.website && safeUrl(p.website) ? safeUrl(p.website) : '';
    var meta = '';
    if (p.location) meta += '<span>📍 ' + esc(p.location) + '</span>';
    if (web) meta += '<a href="' + esc(web) + '" target="_blank" rel="noopener nofollow">🔗 ' + esc(web.replace(/^https?:\/\//, '').replace(/\/$/, '')) + '</a>';
    var btn = PV.isMe
      ? '<div style="display:flex;gap:8px;align-items:center"><button class="dm-btn sec dm-pbtn" data-act="edit">Edit profile</button><button class="dm-btn sec dm-pbtn dm-logout" data-act="logout">Logout</button></div>'
      : '<button class="dm-btn ' + (PV.fol ? 'sec' : 'pri') + ' dm-pbtn" data-act="follow" id="fBtn">' + (PV.fol ? 'Following' : 'Follow') + '</button>';
    var create = PV.isMe
      ? '<div class="dm-create"><div class="dm-cr-t">Create</div><div class="dm-cr-row"><button data-mk="dwall">Dwall</button><button data-mk="dreels">Dreel</button><button data-mk="dlooks">Dlook</button></div></div>'
      : '';
    $('#pHead').innerHTML =
      '<div class="dm-pbanner">' + banner + '</div>' +
      '<div class="dm-phead"><div class="dm-pav">' + avInner(p, name) + '</div>' + btn + '</div>' +
      '<div class="dm-pname">' + esc(name) + '</div><div class="dm-puser">@' + esc(p.username) + '</div>' +
      (p.bio ? '<div class="dm-pbio">' + esc(p.bio) + '</div>' : '') +
      (meta ? '<div class="dm-pmeta">' + meta + '</div>' : '') +
      '<div class="dm-pstats"><div><b>' + Number(st.posts || 0) + '</b><span>Posts</span></div>' +
      '<div data-act="followers"><b>' + Number(st.followers || 0) + '</b><span>Followers</span></div>' +
      '<div data-act="following"><b>' + Number(st.following || 0) + '</b><span>Following</span></div></div>' + create;
  }

  function markPTab(k){
    document.querySelectorAll('#ptabs .dm-tab').forEach(function(x){ x.classList.toggle('active', x.getAttribute('data-t') === k); });
  }

  async function showProfile(uid, ctab){
    var el = $('#vProfile'), tok = ++profTok;
    el.innerHTML = '<div id="pHead"><div class="dm-empty">Loading…</div></div>' +
      '<div class="dm-tabs" id="ptabs"><div class="dm-tab" data-t="dwall">Dwall</div><div class="dm-tab" data-t="dreels">Dreels</div><div class="dm-tab" data-t="dlooks">Dlooks</div></div>' +
      '<div id="pfeed"></div>';
    markPTab(ctab || 'dwall');
    var out = await Promise.all([
      DB.from('demos_profiles').select('*').eq('user_id', uid).maybeSingle(),
      DB.from('demos_profile_stats').select('*').eq('user_id', uid).maybeSingle(),
      (me && me.id !== uid) ? DB.from('demos_follows').select('follower_id').eq('follower_id', me.id).eq('following_id', uid).maybeSingle() : Promise.resolve({ data:null })
    ]);
    if (tok !== profTok) return;
    var p = out[0].data;
    if (!p) { el.innerHTML = '<div class="dm-empty">This profile does not exist.</div>'; return; }
    PV = { uid: uid, p: p, st: out[1].data || {}, isMe: !!(me && me.id === uid), fol: !!out[2].data, ctab: ctab || 'dwall' };
    $('#topTitle').textContent = '@' + p.username;
    renderHead();
    markPTab(PV.ctab);
    await loadContent();
  }

  async function loadContent(){
    var kind = PV.ctab, uid = PV.uid, isMe = PV.isMe, list = $('#pfeed'), tok = ++contTok;
    list.innerHTML = '<div class="dm-empty">Loading…</div>';
    var q = DB.from(TABLE[kind]).select('*').eq('user_id', uid).order('created_at', { ascending:false }).limit(40);
    if (kind === 'dlooks') q = q.gt('expires_at', new Date().toISOString());
    var res = await q;
    if (tok !== contTok) return;
    if (res.error) { list.innerHTML = '<div class="dm-empty">Could not load.<br>' + esc(res.error.message) + '</div>'; return; }
    var rows = res.data || [];
    if (!rows.length) {
      list.innerHTML = '<div class="dm-empty">' + (isMe ? 'Nothing here yet.<br>Use the Create buttons above.' : 'Nothing here yet.') + '</div>';
      return;
    }
    rows.forEach(function(r){ r.kind = kind; });
    var prof = await hydrate(rows);
    if (tok !== contTok) return;
    list.innerHTML = rows.map(function(r){ return cardHTML(r, prof); }).join('');
  }

  async function toggleFollow(){
    if (!me) { goLogin(); return; }
    if (!myProfile) { openSetup(); return; }
    if (!PV || PV.isMe || folBusy) return;
    folBusy = true;
    var uid = PV.uid, r;
    try {
      if (PV.fol) {
        r = await DB.from('demos_follows').delete().eq('follower_id', me.id).eq('following_id', uid);
        if (r.error) { toast('Could not unfollow'); return; }
        PV.fol = false; PV.st.followers = Math.max(0, Number(PV.st.followers || 0) - 1); delete followingSet[uid];
      } else {
        r = await DB.from('demos_follows').insert({ follower_id: me.id, following_id: uid });
        if (r.error) { toast('Could not follow'); return; }
        PV.fol = true; PV.st.followers = Number(PV.st.followers || 0) + 1; followingSet[uid] = true;
      }
      feedDirty = true;
      renderHead();
    } finally { folBusy = false; }
  }

  async function showList(kind){
    var uid = PV.uid;
    $('#lsTitle').textContent = kind === 'followers' ? 'Followers' : 'Following';
    $('#lsList').innerHTML = '<div class="dm-empty">Loading…</div>';
    $('#lsBg').classList.add('show');
    var col = kind === 'followers' ? 'follower_id' : 'following_id';
    var other = kind === 'followers' ? 'following_id' : 'follower_id';
    var r = await DB.from('demos_follows').select(col).eq(other, uid).order('created_at', { ascending:false }).limit(200);
    var ids = (r.data || []).map(function(x){ return x[col]; });
    if (!ids.length) { $('#lsList').innerHTML = '<div class="dm-empty">Nobody here yet.</div>'; return; }
    var pr = await DB.from('demos_profiles').select('user_id,display_name,username,avatar_url').in('user_id', ids);
    var byId = {};
    (pr.data || []).forEach(function(p){ byId[p.user_id] = p; });
    $('#lsList').innerHTML = ids.map(function(id){
      var p = byId[id]; if (!p) return '';
      var nm = p.display_name || p.username || 'User';
      return '<div class="dm-lrow" data-uid="' + esc(id) + '"><div class="dm-av">' + avInner(p, nm) + '</div><div><div class="dm-name">' + esc(nm) + '</div><div class="dm-time">@' + esc(p.username) + '</div></div></div>';
    }).join('') || '<div class="dm-empty">Nobody here yet.</div>';
  }

  /* ---------- logout ---------- */
  async function doLogout(){
    if (!confirm('Logout cheyyano?')) return;
    try { await DB.auth.signOut(); } catch(e) { console.error('Signout error:', e); }
    try { localStorage.clear(); sessionStorage.clear(); } catch(e){}
    try { window.top.location.href = '/auth/login.html'; } catch(e){ location.href = '/auth/login.html'; }
  }

  /* ---------- edit profile ---------- */
  function edStatus(t){ $('#ed_status').textContent = t || ''; }
  function openEdit(){
    if (!myProfile) { openSetup(); return; }
    var p = myProfile;
    $('#ed_un').textContent = 'Username: @' + p.username + ' (cannot be changed)';
    $('#ed_name').value = p.display_name || '';
    $('#ed_bio').value = p.bio || '';
    $('#ed_loc').value = p.location || '';
    $('#ed_web').value = p.website || '';
    $('#ed_av').value = ''; $('#ed_bn').value = '';
    edStatus('');
    $('#edBg').classList.add('show');
  }
  function closeEdit(){
    if (edBusy) { toast('Saving… please wait'); return; }
    $('#edBg').classList.remove('show');
  }
  async function saveEdit(){
    if (edBusy) return;
    if (!me) { goLogin(); return; }
    var name = $('#ed_name').value.trim(), bio = $('#ed_bio').value.trim();
    var loc = $('#ed_loc').value.trim(), web = $('#ed_web').value.trim();
    if (!name || name.length > 40) { edStatus('Enter your name (up to 40 characters)'); return; }
    if (web && !/^https?:\/\//i.test(web)) web = 'https://' + web;
    if (web && (!safeUrl(web) || web.length > 200)) { edStatus('Enter a valid website link'); return; }
    var avF = $('#ed_av').files && $('#ed_av').files[0] ? $('#ed_av').files[0] : null;
    var bnF = $('#ed_bn').files && $('#ed_bn').files[0] ? $('#ed_bn').files[0] : null;
    var btn = $('#edSave');
    edBusy = true; btn.disabled = true;
    try {
      var upd = { display_name: name, bio: bio || null, location: loc || null, website: web || null };
      if (avF) { edStatus('Uploading photo…'); upd.avatar_url = await upImage(avF); }
      if (bnF) { edStatus('Uploading banner…'); upd.banner_url = await upImage(bnF); }
      edStatus('Saving…');
      var r = await DB.from('demos_profiles').update(upd).eq('user_id', me.id);
      if (r.error) throw new Error(r.error.message);
      await loadMyProfile();
      edBusy = false;
      $('#edBg').classList.remove('show');
      toast('Profile updated');
      feedDirty = true;
      showProfile(me.id, PV ? PV.ctab : 'dwall');
    } catch (err) {
      edStatus((err && err.message) ? err.message : 'Could not save profile');
    } finally {
      edBusy = false; btn.disabled = false; hideProg();
    }
  }

  /* ---------- DLOOK VIEWER (JS) ---------- */
  var VW = { items: [], i: 0, timer: null };

  async function openViewer(uid){
    var res = await DB.from('demos_dlooks').select('*').eq('user_id', uid).gt('expires_at', new Date().toISOString()).order('created_at', { ascending:true }).limit(30);
    var rows = (res && res.data) || [];
    if (!rows.length) { toast('No active Dlook'); return; }
    VW.items = rows; VW.i = 0;
    var h = '';
    rows.forEach(function(){ h += '<div class="vw-bar"><div class="vw-fill"></div></div>'; });
    $('#vwBars').innerHTML = h;
    $('#vw').classList.add('show');
    vwShow();
  }
  function vwShow(){
    clearTimeout(VW.timer);
    var r = VW.items[VW.i];
    var fills = document.querySelectorAll('#vwBars .vw-fill');
    fills.forEach(function(f, k){ f.style.transition = 'none'; f.style.width = k < VW.i ? '100%' : '0'; });
    $('#vwInfo').textContent = ago(r.created_at) + ' · ' + left(r.expires_at);
    $('#vwCap').textContent = r.caption || '';
    var st = $('#vwStage'); st.innerHTML = '';
    var u = safeUrl(r.media_url);
    if (!u) { vwNext(); return; }
    var cur = fills[VW.i];
    if (r.media_type === 'video') {
      var v = document.createElement('video');
      v.src = u; v.playsInline = true; v.autoplay = true; v.controls = false;
      v.onended = vwNext;
      v.onerror = vwNext;
      v.ontimeupdate = function(){ if (v.duration) cur.style.width = (v.currentTime / v.duration * 100) + '%'; };
      st.appendChild(v);
      var p = v.play();
      if (p && p.catch) p.catch(function(){ v.muted = true; v.play().catch(function(){}); });
    } else {
      var im = new Image();
      im.alt = ''; im.src = u;
      st.appendChild(im);
      void cur.offsetWidth;
      cur.style.transition = 'width 5s linear';
      cur.style.width = '100%';
      VW.timer = setTimeout(vwNext, 5000);
    }
  }
  function vwNext(){
    if (VW.i < VW.items.length - 1) { VW.i++; vwShow(); } else closeViewer();
  }
  function vwPrev(){
    if (VW.i > 0) VW.i--;
    vwShow();
  }
  function closeViewer(){
    clearTimeout(VW.timer);
    $('#vwStage').innerHTML = '';
    $('#vw').classList.remove('show');
  }
  $('#vw').addEventListener('click', function(e){
    if (e.target.closest('.vw-x')) { closeViewer(); return; }
    var w = $('#vw').getBoundingClientRect().width;
    if (e.clientX < w * 0.35) vwPrev(); else vwNext();
  });

  /* ---------- rating ---------- */
  async function submitRating(id, stars){
    if (!me) { goLogin(); return; }
    var kind = K[id] || tab;
    var ex = await DB.from('demos_reviews').select('id').eq('target_type', kind).eq('target_id', id).eq('user_id', me.id).maybeSingle();
    var r;
    if (ex.data) r = await DB.from('demos_reviews').update({ stars: stars, updated_at: new Date().toISOString() }).eq('id', ex.data.id);
    else r = await DB.from('demos_reviews').insert({ target_type: kind, target_id: id, user_id: me.id, stars: stars });
    if (r.error) { toast('Rating failed'); return; }
    M[id] = stars;
    var st = await DB.from('demos_review_stats').select('*').eq('target_type', kind).eq('target_id', id).maybeSingle();
    if (st.data) S[id] = st.data;
    var box = document.querySelector('.dm-rating[data-id="' + id + '"]');
    if (box) box.outerHTML = ratingHTML(id, false);
    toast('Thanks for rating ' + stars + ' ★');
  }

  /* ---------- navigation ---------- */
  function renderMe(){
    var b = $('#meBtn');
    if (!b) return;
    if (myProfile) b.innerHTML = avInner(myProfile, myProfile.display_name || myProfile.username);
    else b.textContent = '👤';
  }
  function applyView(){
    var v = stack[stack.length - 1], isFeed = v.v === 'feed';
    $('#vFeed').style.display = isFeed ? '' : 'none';
    $('#vProfile').style.display = isFeed ? 'none' : '';
    $('#feedTabs').style.display = isFeed ? '' : 'none';
    $('#backBtn').style.display = isFeed ? 'none' : '';
    $('#fab').style.display = isFeed ? '' : 'none';
    if (isFeed) {
      $('#topTitle').textContent = 'Demos';
      if (feedDirty) loadFeed(false);
    } else {
      $('#topTitle').textContent = 'Profile';
      showProfile(v.uid, v.ctab);
    }
    try { window.scrollTo(0, 0); } catch(e){}
  }
  function go(v){ stack.push(v); applyView(); }
  function back(){ if (stack.length > 1) stack.pop(); applyView(); }
  function openProfile(uid, ctab){ go({ v:'profile', uid: uid, ctab: ctab || 'dwall' }); }

  function refreshView(){
    var v = stack[stack.length - 1];
    if (v.v === 'feed') return loadFeed(false);
    return showProfile(v.uid, (PV && PV.uid === v.uid) ? PV.ctab : v.ctab);
  }
  async function load(){ return refreshView(); }

  function afterPost(kind){
    feedDirty = true;
    var v = stack[stack.length - 1];
    if (v.v === 'profile' && me && v.uid === me.id) showProfile(me.id, kind);
    else if (me) go({ v:'profile', uid: me.id, ctab: kind });
  }

  function mk(k){
    $('#crBg').classList.remove('show');
    if (!me) { goLogin(); return; }
    if (!myProfile) { openSetup(); return; }
    tab = k;
    openSheet();
  }
  function openCreate(){
    if (!me) { goLogin(); return; }
    if (!myProfile) { openSetup(); return; }
    $('#crBg').classList.add('show');
  }

  document.addEventListener('click', function(e){
    var t = e.target, el;
    var box = t.closest('.dm-rating');
    if (box) {
      var id = box.getAttribute('data-id');
      if (t.closest('.dm-rate-btn')) {
        if (!me) { goLogin(); return; }
        box.outerHTML = ratingHTML(id, !box.classList.contains('on'));
        return;
      }
      var star = t.closest('.dm-star');
      if (star && box.classList.contains('on')) submitRating(id, Number(star.getAttribute('data-s')));
      return;
    }
    if (t.closest('[data-login]')) { goLogin(); return; }
    el = t.closest('[data-more]');
    if (el) { el.textContent = 'Loading…'; loadFeed(true); return; }
    el = t.closest('[data-mk]');
    if (el) { mk(el.getAttribute('data-mk')); return; }
    el = t.closest('[data-act]');
    if (el) {
      var a = el.getAttribute('data-act');
      if (a === 'edit') openEdit();
      else if (a === 'logout') doLogout();
      else if (a === 'follow') toggleFollow();
      else if (a === 'followers' || a === 'following') showList(a);
      return;
    }
    el = t.closest('.dm-bub[data-uid]');
    if (el) { openViewer(el.getAttribute('data-uid')); return; }
    el = t.closest('[data-uid]');
    if (el) { $('#lsBg').classList.remove('show'); openProfile(el.getAttribute('data-uid'), el.getAttribute('data-ctab')); return; }
    el = t.closest('#ptabs .dm-tab');
    if (el && PV) { PV.ctab = el.getAttribute('data-t'); markPTab(PV.ctab); loadContent(); return; }
    el = t.closest('#feedTabs .dm-tab');
    if (el) {
      mode = el.getAttribute('data-m');
      document.querySelectorAll('#feedTabs .dm-tab').forEach(function(x){ x.classList.toggle('active', x === el); });
      loadFeed(false);
      return;
    }
  });

  $('#backBtn').addEventListener('click', back);
  $('#meBtn').addEventListener('click', function(){
    if (!me) { goLogin(); return; }
    if (!myProfile) { openSetup(); return; }
    openProfile(me.id, 'dwall');
  });
  $('#crCancel').addEventListener('click', function(){ $('#crBg').classList.remove('show'); });
  $('#lsClose').addEventListener('click', function(){ $('#lsBg').classList.remove('show'); });
  $('#edCancel').addEventListener('click', closeEdit);
  $('#edSave').addEventListener('click', saveEdit);
  $('#crBg').addEventListener('click', function(e){ if (e.target.id === 'crBg') $('#crBg').classList.remove('show'); });
  $('#lsBg').addEventListener('click', function(e){ if (e.target.id === 'lsBg') $('#lsBg').classList.remove('show'); });
  $('#edBg').addEventListener('click', function(e){ if (e.target.id === 'edBg') closeEdit(); });
  renderMe();

  /* ---------- upload helpers ---------- */
  function showProg(p, t){
    $('#prog').style.display = 'block';
    var b = $('#progB');
    b.classList.toggle('ind', p == null);
    if (p != null) b.style.width = p + '%';
    $('#progT').textContent = t || '';
  }
  function hideProg(){ $('#prog').style.display = 'none'; $('#progT').textContent = ''; }
  function getFile(){ var el = document.getElementById('f_file'); return el && el.files && el.files[0] ? el.files[0] : null; }

  function compress(file){
    return new Promise(function(res){
      if (file.type === 'image/gif') { res(file); return; }
      var url = URL.createObjectURL(file), img = new Image();
      img.onload = function(){
        var k = Math.min(1, 1600 / Math.max(img.width, img.height));
        var c = document.createElement('canvas');
        c.width = Math.round(img.width * k); c.height = Math.round(img.height * k);
        var x = c.getContext('2d');
        x.fillStyle = '#fff'; x.fillRect(0, 0, c.width, c.height);
        x.drawImage(img, 0, 0, c.width, c.height);
        URL.revokeObjectURL(url);
        c.toBlob(function(b){ res(b && b.size < file.size ? b : file); }, 'image/jpeg', 0.85);
      };
      img.onerror = function(){ URL.revokeObjectURL(url); res(file); };
      img.src = url;
    });
  }

  async function upImage(file){
    if (!/^image\//.test(file.type)) throw new Error('Please choose an image');
    showProg(null, 'Preparing image…');
    var f = await compress(file);
    var ext = { 'image/jpeg':'jpg', 'image/png':'png', 'image/webp':'webp', 'image/gif':'gif' }[f.type];
    if (!ext) throw new Error('Use a JPG, PNG, WEBP or GIF image');
    if (f.size > 5 * 1024 * 1024) throw new Error('Image must be under 5 MB');
    showProg(null, 'Uploading image…');
    var path = me.id + '/' + Date.now() + '-' + Math.random().toString(36).slice(2, 8) + '.' + ext;
    var r = await DB.storage.from(BUCKET).upload(path, f, { contentType: f.type, cacheControl: '31536000', upsert: false });
    if (r.error) throw new Error(r.error.message);
    return DB.storage.from(BUCKET).getPublicUrl(path).data.publicUrl;
  }

  async function upVideo(file){
    if (!/^video\//.test(file.type)) throw new Error('Please choose a video file');
    showProg(null, 'Uploading video…');
    return await uploadToCloudflareStream(file, function(p){ showProg(p, 'Uploading video… ' + p + '%'); });
  }

  /* ---------- new post sheet ---------- */
  function openSheet(){
    if (!me) { goLogin(); return; }
    if (!myProfile) { openSetup(); return; }
    var f = '';
    if (tab === 'dwall') {
      $('#sheetTitle').textContent = 'New Dwall post';
      f = '<label>What is on your mind?</label><textarea id="f_body" maxlength="2000"></textarea>' +
          '<label>Photo (optional)</label><input id="f_file" type="file" accept="image/*"><div class="dm-prev" id="f_prev"></div>';
    } else if (tab === 'dreels') {
      $('#sheetTitle').textContent = 'New Dreel';
      f = '<label>Video</label><input id="f_file" type="file" accept="video/*"><div class="dm-prev" id="f_prev"></div>' +
          '<label>Caption (optional)</label><textarea id="f_cap" maxlength="500"></textarea>';
    } else {
      $('#sheetTitle').textContent = 'New Dlook (disappears in 12 hours)';
      f = '<label>Photo or video</label><input id="f_file" type="file" accept="image/*,video/*"><div class="dm-prev" id="f_prev"></div>' +
          '<label>Caption (optional)</label><textarea id="f_cap" maxlength="300"></textarea>';
    }
    $('#sheetForm').innerHTML = f;
    hideProg();
    var fi = document.getElementById('f_file');
    if (fi) fi.addEventListener('change', function(){
      var file = getFile(), pv = $('#f_prev');
      if (!file) { pv.innerHTML = ''; return; }
      var mb = (file.size / 1024 / 1024).toFixed(1) + ' MB';
      if (/^image\//.test(file.type)) {
        pv.innerHTML = esc(file.name) + ' · ' + mb + '<img src="' + URL.createObjectURL(file) + '" alt="">';
      } else {
        pv.textContent = file.name + ' · ' + mb;
      }
    });
    $('#sheetBg').classList.add('show');
  }
  function closeSheet(){
    if (busy) { toast('Uploading… please wait'); return; }
    $('#sheetBg').classList.remove('show');
  }
  function val(id){ var el = document.getElementById(id); return el ? el.value.trim() : ''; }

  async function post(){
    if (busy) return;
    var file = getFile(), row = { user_id: me.id }, btn = $('#sheetPost');

    if (tab === 'dwall') {
      row.body = val('f_body') || null;
      if (!row.body && !file) { toast('Write something or add a photo'); return; }
    } else if (tab === 'dreels') {
      if (!file) { toast('Choose a video'); return; }
      row.caption = val('f_cap') || null;
    } else {
      if (!file) { toast('Choose a photo or video'); return; }
      row.caption = val('f_cap') || null;
    }

    busy = true; btn.disabled = true;
    try {
      if (tab === 'dwall') {
        if (file) row.media_url = await upImage(file);
      } else if (tab === 'dreels') {
        var v = await upVideo(file);
        row.video_url = v.videoUrl;
        row.thumbnail_url = v.thumbnailUrl;
      } else if (/^video\//.test(file.type)) {
        var v2 = await upVideo(file);
        row.media_url = v2.videoUrl;
        row.media_type = 'video';
      } else {
        row.media_url = await upImage(file);
        row.media_type = 'image';
      }
      showProg(null, 'Saving…');
      var r = await DB.from(TABLE[tab]).insert(row);
      if (r.error) throw new Error(r.error.message);
      busy = false;
      closeSheet(); toast('Posted'); afterPost(tab);
    } catch (err) {
      toast((err && err.message) ? err.message : 'Upload failed');
    } finally {
      busy = false; btn.disabled = false; hideProg();
    }
  }

  /* ===== DEMOS PROFILE SETUP (JS) ===== */
  var myProfile = null, pfBusy = false;

  async function loadMyProfile(){
    if (!me) { myProfile = null; return; }
    var r = await DB.from('demos_profiles').select('*').eq('user_id', me.id).maybeSingle();
    myProfile = r && r.data ? r.data : null;
    renderMe();
  }
  function pfStatus(t){ $('#pf_status').textContent = t || ''; }
  function openSetup(){
    $('#pf_user').value = ''; $('#pf_name').value = ''; $('#pf_bio').value = '';
    $('#pf_av').value = ''; $('#pf_bn').value = '';
    pfStatus('');
    $('#pfBg').classList.add('show');
  }
  function closeSetup(){
    if (pfBusy) { toast('Saving… please wait'); return; }
    $('#pfBg').classList.remove('show');
  }
  async function saveProfile(){
    if (pfBusy) return;
    if (!me) { goLogin(); return; }
    var username = $('#pf_user').value.trim().toLowerCase();
    var name = $('#pf_name').value.trim();
    var bio = $('#pf_bio').value.trim();
    if (!/^[a-z0-9_]{3,20}$/.test(username)) { pfStatus('Username: 3 to 20 characters, a-z, 0-9 and _'); return; }
    if (!name || name.length > 40) { pfStatus('Enter your name (up to 40 characters)'); return; }
    var avF = $('#pf_av').files && $('#pf_av').files[0] ? $('#pf_av').files[0] : null;
    var bnF = $('#pf_bn').files && $('#pf_bn').files[0] ? $('#pf_bn').files[0] : null;
    var btn = $('#pfSave');
    pfBusy = true; btn.disabled = true;
    try {
      var row = { user_id: me.id, username: username, display_name: name, bio: bio || null };
      if (avF) { pfStatus('Uploading photo…'); row.avatar_url = await upImage(avF); }
      if (bnF) { pfStatus('Uploading banner…'); row.banner_url = await upImage(bnF); }
      pfStatus('Saving…');
      var r = await DB.from('demos_profiles').insert(row);
      if (r.error) {
        if (r.error.code === '23505') throw new Error('That username is taken. Try another.');
        throw new Error(r.error.message);
      }
      await loadMyProfile();
      pfBusy = false;
      $('#pfBg').classList.remove('show');
      toast('Profile created');
      load();
    } catch (err) {
      pfStatus((err && err.message) ? err.message : 'Could not save profile');
    } finally {
      pfBusy = false; btn.disabled = false; hideProg();
    }
  }
  $('#pfCancel').addEventListener('click', closeSetup);
  $('#pfSave').addEventListener('click', saveProfile);

  $('#fab').addEventListener('click', openCreate);
  $('#sheetCancel').addEventListener('click', closeSheet);
  $('#sheetPost').addEventListener('click', post);
  $('#sheetBg').addEventListener('click', function(e){ if (e.target.id === 'sheetBg') closeSheet(); });

  (async function init(){
    try {
      var u = await DB.auth.getUser();
      me = u && u.data ? u.data.user : null;
    } catch(e){ me = null; }
    await load();
    if (!me) toast('Log in to post and rate');
    else {
      try { await loadMyProfile(); } catch(e){ myProfile = null; }
      if (!myProfile) openSetup();
    }
  })();
})();
</script>
</body>
</html>
